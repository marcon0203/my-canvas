{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 短视频工厂",
  "version": "0.1.0",
  "identifier": "ai.studio.video",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI 短视频工厂",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "../../resources/skills": "skills",
      "../../resources/models": "models"
    }
  }
}
